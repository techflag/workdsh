    "typecheck": "corepack pnpm --filter workdsh-provider-browser-session typecheck && corepack pnpm --filter workdsh-contracts typecheck && corepack pnpm --filter workdsh-provider-identity-local typecheck && corepack pnpm --filter workdsh-plugin-audit typecheck && corepack pnpm --filter workdsh-plugin-access typecheck && corepack pnpm --filter workdsh-plugin-skills typecheck && corepack pnpm --filter workdsh-plugin-experts typecheck && corepack pnpm --filter workdsh-plugin-connectors typecheck && corepack pnpm --filter workdsh-plugin-office typecheck && corepack pnpm --filter workdsh-plugin-library typecheck && corepack pnpm --filter workdsh-plugin-projects typecheck && corepack pnpm --filter workdsh-bundle typecheck && corepack pnpm --filter workdsh-plugin-activity typecheck",
    "probe:install": "node scripts/check-environment.mjs && node scripts/probe-install.mjs",
    "probe:activity": "node scripts/probe-activity.mjs",
    "test:activity": "node --test packages/plugins/activity/tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check:versions": "node scripts/check-published-versions.mjs",
    "probe:browser": "node scripts/check-environment.mjs && node scripts/probe-install.mjs --browser",
    "probe:presets": "node scripts/check-environment.mjs && node scripts/probe-presets.mjs",
    "probe:remote:generate": "tsc -p examples/remote-probe/packages/probe/tsconfig.json && node scripts/build-remote-probe.mjs",
    "test:remote:lifecycle": "tsc -p examples/remote-probe/packages/probe/tsconfig.json && node --test tests/remote/*.test.mjs",
    "preview:install": "node scripts/check-environment.mjs && node scripts/install-preview.mjs",
    "probe:skills": "node scripts/check-environment.mjs && node scripts/probe-skills-package.mjs",
    "probe:experts": "node scripts/check-environment.mjs && node scripts/probe-experts-package.mjs",
    "probe:experts:official": "node scripts/check-environment.mjs && node scripts/probe-native-team-web.mjs",
    "probe:experts:professional": "node scripts/check-environment.mjs && node scripts/probe-experts-professional.mjs",
    "probe:office": "node scripts/probe-office.mjs",
    "probe:office:native": "node scripts/probe-office-native.mjs",
    "probe:office:live": "node scripts/probe-office-live.mjs",
    "probe:office:word-only": "node scripts/probe-office-word-only-scope.mjs",
    "test:office:content": "node --test tests/integration/office-content.test.mjs",
    "test:office:csv": "node --test tests/integration/office-csv-preview.test.mjs",
    "release:office:pack": "node scripts/pack-office-release.mjs",
    "release:library:pack": "node scripts/pack-library-release.mjs",
    "release:project:pack": "node scripts/pack-project-release.mjs",
    "audit:skills": "node scripts/quality/audit-skills.mjs",
    "test:skill-quality": "node --test scripts/quality/audit-skills.test.mjs",
    "probe:experts:team": "node scripts/check-environment.mjs && node scripts/probe-native-expert-team.mjs",
    "probe:experts:team:web": "node scripts/check-environment.mjs && node scripts/probe-native-team-web.mjs",
    "probe:experts:team:resilience": "node scripts/check-environment.mjs && node scripts/probe-native-team-web.mjs",
    "probe:experts:team:real": "node scripts/check-environment.mjs && node scripts/probe-native-team-web.mjs --real-model",
    "probe:computer-use:native": "node scripts/probe-computer-use-native.mjs",
    "probe:browser-use:playwright": "node scripts/probe-browser-use-playwright.mjs",
    "probe:mcp:resources": "node scripts/probe-mcp-resources.mjs",
    "probe:connectors": "node scripts/probe-connectors.mjs",
    "probe:headless": "node scripts/probe-headless-interface.mjs",
    "probe:subagent:activation-limit": "node scripts/probe-subagent-activation-limit.mjs",
    "test:library": "corepack pnpm --filter workdsh-plugin-library test",
