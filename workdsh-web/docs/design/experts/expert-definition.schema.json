{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkDSH ExpertDefinition 1.0 — proposed design",
  "description": "Design artifact only. Runtime must also enforce UTF-8 aggregate size, dependency readiness, identity, duplicate semantic IDs, CAS and confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "role",
    "methodology",
    "boundaries",
    "deliverables",
    "tags",
    "examples",
    "skillRequirements",
    "futureRequirements"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "avatarRef": {
      "type": "string",
      "pattern": "^avatar-[a-zA-Z0-9-]{1,80}$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "methodology": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "boundaries": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "deliverables": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "categoryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    },
    "examples": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "skillRequirements": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
          },
          "skillId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "futureRequirements": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "key",
          "required",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "asset",
              "connector"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
