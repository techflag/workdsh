{
  "name": "workdsh-bundle",
  "version": "0.1.0-alpha.50",
  "private": true,
  "type": "module",
  "description": "WorkDSH default Harness bundle and client composition",
  "exports": {
    "./probe": {
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    ".": {
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "corepack pnpm --filter workdsh-ui build && corepack pnpm --filter workdsh-plugin-workbench build && tsc -p tsconfig.json && node ../../scripts/build-client-probe.mjs",
    "typecheck": "corepack pnpm --filter workdsh-ui build && corepack pnpm --filter workdsh-plugin-workbench typecheck && tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@types/react": "19.2.14",
    "react": "19.2.4",
    "workdsh-plugin-workbench": "workspace:*",
    "workdsh-ui": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "0.1.7-rc.2",
    "@deepseek-ai/dsh-computer-use": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-auto-review": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-native": "0.1.7-rc.2",
    "yaml": "2.9.0"
  }
}
